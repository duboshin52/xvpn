# Настройки канарейки → /etc/xvpn/canary.env на главном сервере
# Токен Cloudflare для автоочистки DNS кластера от мёртвых IP.
# Scope: Zone → DNS → Edit, только зона вашего домена. Пусто — только алерты.
CF_TOKEN=
# ID зоны домена в Cloudflare (Overview → справа внизу)
CF_ZONE=
# Адрес внешнего сторожа (healthchecks.io и т. п.): дёргается после каждого прогона.
# Молчание сторожа означает, что главный сервер умер и алертов от него не будет
HEARTBEAT_URL=
# IP удаляется из DNS после стольких неудачных прогонов подряд
DEAD_AFTER=3
# Меньше стольких A-записей автоматика не оставит
MIN_DNS=2
