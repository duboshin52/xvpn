# Настройки балансировщика → /etc/xvpn/balancer.env на главном сервере
# Сколько трафика отдаёт один выход перед «отдыхом»
LIMIT_GB=200
# Страховка: принудительное отключение выхода (лимит VPS 2 ТБ — держим запас)
HARD_CAP_GB=1800
# Сколько выходов одновременно активно в каскаде (рабочий + резерв)
PAIR=2
# Число месяца, с которого обнуляются счётчики (день начала биллинга VPS)
RESET_DAY=1
# Принудительная смена активных выходов раз в N дней, даже без выработки лимита
# (размывает привычную картину трафика для поведенческого анализа; 0 — выключено)
ROTATE_DAYS=7
